# BlockN Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# =============================================================================
# OpenAI API Configuration (for AI Architect mode)
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Leave blank to disable AI Architect mode
OPENAI_API_KEY=

# OpenAI model to use (optional, defaults to gpt-4)
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# =============================================================================
# Blender Integration (optional, for advanced boolean operations)
# =============================================================================
# Path to Blender executable
# Windows example: C:/Program Files/Blender Foundation/Blender 4.0/blender.exe
# Linux example: /usr/bin/blender
# macOS example: /Applications/Blender.app/Contents/MacOS/Blender
# Leave blank to disable Blender integration
BLENDER_PATH=

# =============================================================================
# Application Settings
# =============================================================================
# Default scene dimensions
DEFAULT_WIDTH=10
DEFAULT_HEIGHT=10
DEFAULT_DEPTH=10

# Default support checking mode (HYBRID, GRID, OFF)
DEFAULT_SUPPORT_MODE=HYBRID

# Default collision checking (True/False)
DEFAULT_COLLISION_CHECK=True

# =============================================================================
# File Paths
# =============================================================================
# Default export directory (relative to project root)
EXPORT_DIR=exports

# Default save directory for JSON scenes
SAVE_DIR=saves

# =============================================================================
# Performance Settings
# =============================================================================
# Enable pyembree for faster support checking (True/False)
# Only works if pyembree is installed
USE_PYEMBREE=True

# Maximum blocks before warning (for performance)
MAX_BLOCKS_WARNING=5000

# =============================================================================
# Development/Debug
# =============================================================================
# Enable debug logging (True/False)
DEBUG=False

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable verbose output for generation
VERBOSE=False
