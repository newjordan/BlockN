# Copy to `.env` if you want to override the built-in defaults.
# This file stays in source control. Never commit `.env`.

# Accepted but unused by this branch. No feature calls OpenAI or Blender.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
BLENDER_PATH=

# GUI spin boxes and CLI defaults when the matching flag is omitted.
# Classical width and depth below 6 are raised to 6.
DEFAULT_WIDTH=5
DEFAULT_HEIGHT=5
DEFAULT_DEPTH=5
DEFAULT_SUPPORT_MODE=HYBRID
DEFAULT_COLLISION_CHECK=True

# Output directories, relative to the repository root unless absolute.
# They are created when you export, not when configuration is read.
EXPORT_DIR=exports
SAVE_DIR=saves

# Accepted but unused by this branch.
USE_PYEMBREE=True
MAX_BLOCKS_WARNING=5000
DEBUG=False
LOG_LEVEL=INFO
VERBOSE=False
